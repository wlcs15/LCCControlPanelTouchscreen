# QEMU-only overrides (appended after sdkconfig.defaults via SDKCONFIG_DEFAULTS).
# Product hardware stays on Octal PSRAM @ 120MHz QIO in sdkconfig.defaults.
# Espressif QEMU (esp-develop 9.2.x) needs Quad PSRAM + -m, DIO, and matching
# flash image size; 120MHz octal hits BBPLL/MSPI tuning asserts, and QIO flash
# init often fails under the emulator.

# Flash: DIO 40MHz 16MB (header size must match merge --fill-flash-size)
# CONFIG_ESPTOOLPY_FLASHMODE_QIO is not set
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# CONFIG_ESPTOOLPY_FLASHFREQ_120M is not set
# CONFIG_ESPTOOLPY_FLASHFREQ_80M is not set
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPI_FLASH_HPM_DIS=y

# PSRAM: Quad @ 40MHz (enable with qemu -m 8M; do NOT pass is_octal)
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_SPIRAM_MODE_QUAD=y
# CONFIG_SPIRAM_SPEED_120M is not set
# CONFIG_SPIRAM_SPEED_80M is not set
CONFIG_SPIRAM_SPEED_40M=y
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set
